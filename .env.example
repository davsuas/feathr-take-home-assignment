# Every setting the platform reads. No secrets here - values are safe placeholders.
APP_ENV=local
LOG_LEVEL=INFO

MONGO_URI=mongodb://mongodb:27017
MONGO_DATABASE=eventplatform

ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=events-v1

REDIS_URL=redis://redis:6379/0

QUEUE_BACKEND=memory          # memory | rabbitmq
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
QUEUE_CAPACITY=10000
QUEUE_PUBLISH_TIMEOUT_SECONDS=2.0
QUEUE_VISIBILITY_TIMEOUT_SECONDS=30

RETRY_MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=1.0
RETRY_CAP_SECONDS=60.0

REALTIME_CACHE_TTL_SECONDS=30
SINGLE_FLIGHT_LOCK_TTL_SECONDS=5

MAX_PAGE_SIZE=200
DEFAULT_PAGE_SIZE=50
MAX_AGGREGATE_RANGE_DAYS=92
OCCURRED_AT_MAX_FUTURE_SECONDS=300
OCCURRED_AT_MAX_PAST_DAYS=90

METADATA_MAX_BYTES=16384
METADATA_MAX_DEPTH=3
METADATA_MAX_KEYS=50

RATE_LIMIT_PER_MINUTE=6000
RECONCILER_INTERVAL_SECONDS=15
RECONCILER_STALE_AFTER_SECONDS=30
